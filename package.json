{
  "name": "payby",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check:readiness": "node scripts/readiness-check.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/router.test.ts tests/wallet-network.test.ts tests/transaction-history.test.ts tests/access-and-storage.test.ts",
    "verify": "npm run build",
    "verify:community": "npm run verify && npm run check:readiness",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^5.2.1",
    "@aptos-labs/wallet-adapter-react": "^7.2.8",
    "@shelby-protocol/react": "4.1.0",
    "@shelby-protocol/sdk": "0.7.0",
    "@tanstack/react-query": "^5.90.12",
    "buffer": "^6.0.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^6.0.7"
  }
}
